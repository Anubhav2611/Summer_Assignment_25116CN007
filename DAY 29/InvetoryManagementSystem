#include <stdio.h>

struct Product
{
    int productId;
    char productName[50];
    int quantity;
    float price;
};

int main()
{
    struct Product item[50];
    int n, i;

    printf("Enter number of products: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nProduct %d\n", i + 1);

        printf("Enter Product ID: ");
        scanf("%d", &item[i].productId);

        printf("Enter Product Name: ");
        scanf("%s", item[i].productName);

        printf("Enter Quantity: ");
        scanf("%d", &item[i].quantity);

        printf("Enter Price: ");
        scanf("%f", &item[i].price);
    }

    printf("\n===== Inventory Details =====\n");

    for(i = 0; i < n; i++)
    {
        printf("\nProduct ID   : %d\n", item[i].productId);
        printf("Product Name : %s\n", item[i].productName);
        printf("Quantity     : %d\n", item[i].quantity);
        printf("Price        : %.2f\n", item[i].price);
    }

    return 0;
}
